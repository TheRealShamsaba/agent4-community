# Local setup needs no edits. For a domain, use HTTPS and your own URL.
AGENT4_PUBLIC_URL=http://localhost:8782
AGENT4_HOST_PORT=8782
AGENT4_TIME_ZONE=UTC
# Only enable behind a reverse proxy that strips client-supplied proxy headers.
AGENT4_TRUST_PROXY=false
# Optional AI. Core tools and built-in assistant answers work without a model.
AGENT4_AI_PROVIDER=ollama
AGENT4_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=
OPENAI_API_KEY=
# Optional GitHub connection; use a token limited to repositories you choose.
AGENT4_GITHUB_TOKEN=
# Optional transcription service. No audio leaves the server until enabled.
AGENT4_VOICE_TRANSCRIPTION_ENABLED=false
AGENT4_VOICE_TRANSCRIPTION_URL=http://host.docker.internal:8178/inference
# Optional Telegram mini app and completion notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=
TELEGRAM_OWNER_CHAT_ID=
AGENT4_TELEGRAM_USERNAME=
# Optional client pages: configure a separate hostname, then enable explicitly.
AGENT4_CLIENT_PAGES=false
AGENT4_CLIENT_HOSTS=
AGENT4_CLIENT_URL=
AGENT4_CLIENT_WHATSAPP=
AGENT4_CLIENT_EMAIL=
# Optional public inquiry form. Restrict to your own website's HTTPS origin.
AGENT4_PUBLIC_INQUIRY=false
AGENT4_INQUIRY_ORIGINS=
# Optional Google Calendar adapter credentials; local calendar needs none.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
