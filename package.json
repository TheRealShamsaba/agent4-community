{
  "name": "agent4-community",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/hq-server.js",
    "setup": "node scripts/setup.js",
    "reset-password": "node --env-file-if-exists=.env scripts/reset-password.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "hq:serve": "npm start",
    "hq:build": "npm --prefix hq run build && node scripts/build-ui.js",
    "dev": "npm --prefix hq run dev",
    "lint": "eslint src test hq/src scripts",
    "test": "node --test --test-concurrency=4",
    "verify": "npm run lint && npm test && npm run hq:build && npm run docs:check && npm run privacy:check",
    "docs:check": "node scripts/check-docs.js",
    "privacy:check": "node scripts/check-public-source.js",
    "security:secrets": "sh scripts/scan-secrets.sh",
    "sbom": "node scripts/generate-sbom.js"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "chrono-node": "^2.10.1",
    "jsonrepair": "3.15.0",
    "luxon": "^3.7.2",
    "openai": "^7.30.1",
    "robots-parser": "^3.0.1",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "eslint": "10.10.0",
    "fake-indexeddb": "^6.2.6"
  },
  "description": "A free, self-hosted workspace for small teams building their first company.",
  "license": "AGPL-3.0-only"
}
